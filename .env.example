# Atlas backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server binding ---
# Host/IP the API binds to (default 127.0.0.1). On Render use 0.0.0.0.
HOST=127.0.0.1
# Port the API listens on (default 3001).
PORT=3001
# Local vs production. Render sets this to 'production'.
NODE_ENV=production

# --- Database ---
# Preferred: full Postgres connection string. When set, the PGHOST/PGPORT/etc.
# variables below are ignored.
DATABASE_URL=postgres://user:password@localhost:5432/atlas?sslmode=require
# Alternative local connection settings (used only when DATABASE_URL is empty).
#PGHOST=127.0.0.1
#PGPORT=5432
#PGDATABASE=atlas
#PGUSER=mac
#PGPASSWORD=

# --- CORS / sessions ---
# Comma-separated list of allowed frontend origins (no trailing slashes).
FRONTEND_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
# Trust proxy is hardcoded to 1 (single reverse proxy hop, as on Render) so
# rate limiting works behind a proxy without extra configuration.
# Canonical frontend URL used for links (e.g. invitation emails).
FRONTEND_APP_URL=https://your-frontend.onrender.com
# Session lifetime: idle timeout and absolute max age in hours/days.
#SESSION_IDLE_HOURS=12
#SESSION_ABSOLUTE_DAYS=14
# Open tasks with no updates for this many days appear in Needs Attention.
#TASK_STALLED_DAYS=7

# --- Optional external service ---
# Webhook called when an invitation is sent (optional). Leave empty to disable.
#INVITATION_DELIVERY_WEBHOOK_URL=

# --- Bootstrap admin (created on startup if no admin exists) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Vault encryption ---
# 64-character hexadecimal string (32 bytes). Must NOT change once set, or
# existing secrets become unreadable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=
# Key version tag stored alongside each secret (default v1).
#VAULT_KEY_VERSION=v1
