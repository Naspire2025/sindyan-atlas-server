{
  "name": "pms-backend",
  "version": "0.1.0",
  "description": "Internal project management system - backend API",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/db/migrate.test.js dist/db/integration.test.js",
    "test:unit": "npm run build && node --test dist/services/project.service.test.js",
    "seed": "node scripts/seedProjects.js",
    "seed:check": "node scripts/seedProjects.js --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
